# ==============================================================================
# Google Cloud Composer Workshop — Example Configuration (.env.example)
# Copy this file to `.env` and replace with your actual GCP project values:
#   cp .env.example .env
# ==============================================================================

# --- 1. Core Google Cloud Project Settings ---
GCP_PROJECT_ID="poc-example-ds"
GCP_REGION="europe-west1"
BQ_LOCATION="EU"

# --- 2. Service Account Configuration ---
SERVICE_ACCOUNT_NAME="example-workshop-composer-sa"
SERVICE_ACCOUNT_EMAIL="example-workshop-composer-sa@poc-example-ds.iam.gserviceaccount.com"

# --- 3. VPC & Networking Configuration ---
VPC_NETWORK_NAME="composer-workshop-vpc"
SUBNET_NAME="composer-workshop-subnet"
PRIMARY_IP_RANGE="10.10.0.0/20"
GKE_PODS_RANGE_NAME="gke-pods-range"
GKE_PODS_IP_RANGE="10.10.16.0/22"
GKE_SERVICES_RANGE_NAME="gke-services-range"
GKE_SERVICES_IP_RANGE="10.10.20.0/22"

# --- 4. Cloud Composer Environment Settings ---
COMPOSER_ENV_NAME="workshop-composer-v3"
COMPOSER_IMAGE_VERSION="composer-3-airflow-2.10.5"
GCS_DAG_BUCKET="europe-west1-workshop-comop-01f64e99-bucket"

# --- 5. Dataproc Serverless & BigQuery ETL Settings ---
SPARK_TEMP_BUCKET="example-dataproc-workshop"
RAW_LANDING_BUCKET="example-dataproc-workshop"
BQ_DATASET_ID="example_composer_workshop"
BQ_INPUT_TABLE_ID="poc-example-ds.example_composer_workshop.sales_data"
BQ_OUTPUT_TABLE_ID="poc-example-ds.example_composer_workshop.filtered_sales"
DEFAULT_PROCESSING_DATE="2025-06-12"

# --- 6. Airflow Variables (Automatically mapped by Airflow via AIRFLOW_VAR_* prefix) ---
AIRFLOW_VAR_GCP_PROJECT_ID="poc-example-ds"
AIRFLOW_VAR_SUBNET_NAME="composer-workshop-subnet"
AIRFLOW_VAR_AIRFLOW_WORKER_GCP_SERVICE_ACCOUNT="example-workshop-composer-sa@poc-example-ds.iam.gserviceaccount.com"
AIRFLOW_VAR_RAW_LANDING_BUCKET="example-dataproc-workshop"
